NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Use SMTP for a provider like Maileroo, Gmail, or a school mail server.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SPCC Appointments <your-sender@example.com>"

# Alternative: set EMAIL_PROVIDER=resend and supply the API key.
RESEND_API_KEY=
